DATABASE_URL="postgresql://eastgate:eastgate_secret@localhost:5432/eastgate_db?schema=public"
PORT=3000

# Used to sign session tokens. Must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="replace_me_with_a_long_random_string"

# Comma-separated browser origins allowed to call the API cross-origin.
# Leave unset to use the localhost defaults. Same-origin requests (serving the
# pages from this process) need no configuration and always work.
# ALLOWED_ORIGINS="https://app.eastgate.ng,https://www.eastgate.ng"

# Password for the seeded super-admin (admin@eastgate.com).
#
# Read only by prisma/seed.ts, and only when that account does not already exist.
# It lives here rather than in seed.ts so the credential never enters version
# control — `.env` is gitignored. Re-running the seed will NOT change the
# password of an admin that already exists.
#
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_SEED_PASSWORD="replace_me_with_a_strong_admin_password"

# Set to 1 to let `npm run db:seed` overwrite a database that holds real accounts.
# Without it the seed refuses to run rather than deleting production data.
# ALLOW_DESTRUCTIVE_SEED=1

# --- Outbound email (verification, password reset, booking notices) ---
# Leave SMTP_HOST unset to keep the "logged, not sent" development transport.
# The app never fails a request because mail is down.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER="no-reply@eastgate.ng"
# SMTP_PASS="replace_me"
# MAIL_FROM="East Gate <no-reply@eastgate.ng>"

# Dev email catcher. With SMTP_HOST unset, set MAIL_DEV_CATCH=true to deliver
# mail to a throwaway Ethereal inbox and print a preview URL per message — no
# mailbox or credentials needed. Ignored once SMTP_HOST is set.
# MUST be false/unset in production; the server prints a startup warning if it
# is on while no SMTP host is configured.
# MAIL_DEV_CATCH=false

# Absolute public URL used inside emailed links (and canonical/OG/sitemap URLs).
# Needed when the app runs behind a proxy or reverse proxy, where the request
# host would otherwise be internal.
#   Local dev:   http://localhost:3000  (so reset/verify links resolve locally)
#   Production:  https://www.eastgate.ng
# Leave unset to derive it from the request host (fine for same-origin local use).
# APP_BASE_URL="http://localhost:3000"