datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  DEALER
  ADMIN
  SUPER_ADMIN
}

enum VerificationStatus {
  NEW
  UNDER_REVIEW
  VERIFIED
  SUSPENDED
  REJECTED
}

enum ItemStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

// Why a property is being offered — the axis a buyer/renter filters on.
// Deliberately distinct from PropertyCategory, which describes what the
// property IS (a house, a shop, a plot of land). A plot of land can be
// BUY (outright purchase) or LAND_BANKING (held for future appreciation).
enum ListingType {
  BUY
  SHORT_LET
  LONG_LET
  LONG_LEASE
  COMMERCIAL_LEASE
  INDUSTRIAL_LEASE
  LAND_BANKING
  DISTRESS_SALE
  JOINT_VENTURE
  STAFF_QUARTERS
}

enum PropertyCategory {
  RESIDENTIAL
  COMMERCIAL
  LAND
  LUXURY
  OFF_PLAN
}

enum TitleDocumentType {
  C_OF_O
  GOVERNORS_CONSENT
  FEDERAL_C_OF_O
  REGISTERED_SURVEY_DEED
  FCDA_ALLOCATION
  GOVERNMENT_GAZETTE
  OTHER
}

enum InspectionStatus {
  PENDING
  CONFIRMED
  COMPLETED
  RESCHEDULED
  CANCELLED
}

// ---------------- USER & IDENTITY ----------------
model User {
  id              String         @id @default(uuid())
  email           String         @unique
  phone           String         @unique
  passwordHash    String
  fullName        String
  role            Role           @default(CUSTOMER)
  avatarUrl       String?
  isActive        Boolean        @default(true)
  emailVerified   Boolean        @default(false)
  // Bumped whenever the password changes. Every session token carries the value
  // it was minted with, so a reset instantly invalidates older sessions instead
  // of leaving a stolen token alive until it expires.
  sessionVersion  Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  dealerProfile   DealerProfile?
  savedProperties SavedListing[]
  inspections     Inspection[]   @relation("UserInspections")
  cancelledInspections Inspection[] @relation("InspectionCancellations")
  auditActions    AuditLog[]     @relation("AdminActions")
  reportsFiled    Report[]
  revokedSessions RevokedSession[]
  authTokens      AuthToken[]
}

// ---------------- DEALER & CREDENTIALS ----------------
model DealerProfile {
  id               String             @id @default(uuid())
  userId           String             @unique
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName     String
  cacNumber        String?            @unique
  category         String             // Real Estate Broker, Contractor, Architect, Supplier
  bio              String?
  state            String
  city             String
  officeAddress    String?
  status           VerificationStatus @default(UNDER_REVIEW)
  
  // 4-Dimensional Verification Badges
  badgeIdentity    Boolean            @default(false)
  badgeCac         Boolean            @default(false)
  badgePhone       Boolean            @default(false)
  badgeTitleDocs   Boolean            @default(false)
  
  ratingAverage    Decimal            @default(5.0) @db.Decimal(2, 1)
  reviewCount      Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  listings         Property[]
  products         MarketplaceProduct[]
  services         ServiceOffering[]
  inspections      Inspection[]       @relation("DealerInspections")
  verifications    VerificationDoc[]
  enquiries        ListingEnquiry[]
}

model VerificationDoc {
  id               String             @id @default(uuid())
  dealerId         String
  dealer           DealerProfile      @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  documentType     String             // CAC_CERT, NIN, TITLE_DEED, TAX_CLEARANCE
  documentUrl      String
  documentName     String
  status           VerificationStatus @default(UNDER_REVIEW)
  reviewedBy       String?
  notes            String?
  submittedAt      DateTime           @default(now())
  reviewedAt       DateTime?
}

// ---------------- PROPERTY MARKETPLACE ----------------
model Property {
  id              String            @id @default(uuid())
  dealerId        String
  dealer          DealerProfile     @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  title           String
  slug            String            @unique
  listingType     ListingType       @default(BUY)
  category        PropertyCategory  @default(RESIDENTIAL)
  price           Decimal           @db.Decimal(14, 2)
  currency        String            @default("NGN")
  state           String
  location        String            // City, LGA, Neighborhood
  bedrooms        Int               @default(0)
  bathrooms       Int               @default(0)
  parkingSpaces   Int               @default(0)
  landSize        String?           // e.g. "800 sqm"
  titleDocument   TitleDocumentType @default(C_OF_O)
  isTitleVerified Boolean           @default(false)
  
  mainImage       String
  galleryImages   String[]          @default([])
  description     String
  features        String[]          @default([])
  
  status          ItemStatus        @default(PENDING_REVIEW) // MUST BE APPROVED BY ADMIN BEFORE PUBLIC VIEWING
  isFeatured      Boolean           @default(false)
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?

  inspections     Inspection[]
  saves           SavedListing[]
  enquiries       ListingEnquiry[]

  // The public catalogue always filters on status + deletedAt and commonly on
  // listingType/state, so index the combination the listing query actually uses.
  @@index([status, listingType])
  @@index([status, state])
}

// ---------------- MARKETPLACE GOODS (BUILDING MATERIALS / INTERIORS) ----------------
model MarketplaceProduct {
  id              String            @id @default(uuid())
  dealerId        String?           // Nullable if created directly by Admin
  dealer          DealerProfile?    @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  name            String
  category        String            // Building Materials, Home & Interior, Equipment
  price           Decimal           @db.Decimal(14, 2)
  stockInfo       String            @default("In Stock")
  mainImage       String
  specifications  String
  
  isOfficial      Boolean           @default(false) // True for East Gate Direct
  status          ItemStatus        @default(PENDING_REVIEW) // Direct Admin listings set to APPROVED
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

// ---------------- SPECIALIST SERVICES ----------------
model ServiceOffering {
  id              String            @id @default(uuid())
  dealerId        String
  dealer          DealerProfile     @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  title           String
  category        String            // Construction, Design, Property, Professional
  coverageState   String            @default("Nationwide")
  description     String
  badges          String[]          @default([])
  status          ItemStatus        @default(PENDING_REVIEW)
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

// ---------------- INSPECTIONS ----------------
model Inspection {
  id              String            @id @default(uuid())
  userId          String
  user            User              @relation("UserInspections", fields: [userId], references: [id])
  propertyId      String
  property        Property          @relation(fields: [propertyId], references: [id])
  dealerId        String
  dealer          DealerProfile     @relation("DealerInspections", fields: [dealerId], references: [id])
  
  date            DateTime          @db.Date
  timeSlot        String            // e.g. "02:00 PM – 03:30 PM"
  status          InspectionStatus  @default(PENDING)
  clientNotes     String?
  dealerNotes     String?
  // Documentation trail for admin-closed appointments (e.g. cancellations).
  adminNotes      String?
  cancelledAt     DateTime?
  cancelledById   String?
  cancelledBy     User?             @relation("InspectionCancellations", fields: [cancelledById], references: [id])
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

// ---------------- SAVED LISTINGS ----------------
model SavedListing {
  id              String            @id @default(uuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId      String
  property        Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt       DateTime          @default(now())

  @@unique([userId, propertyId])
}

// ---------------- LISTING ENQUIRIES ----------------
// A message a visitor sends about one specific listing from property-detail.html.
// Kept separate from ContactMessage because it is tied to a Property (and the
// dealer behind it), which is what makes it actionable for the moderation desk:
// you can see how many buyers asked about a listing and route it to its owner.
// The visitor does not need an account, so userId is optional and only recorded
// when a signed-in customer happens to send one.
model ListingEnquiry {
  id              String            @id @default(uuid())
  propertyId      String
  property        Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  dealerId        String?
  dealer          DealerProfile?    @relation(fields: [dealerId], references: [id], onDelete: SetNull)
  userId          String?
  name            String
  email           String
  phone           String?
  message         String
  createdAt       DateTime          @default(now())
  readAt          DateTime?

  @@index([createdAt])
  @@index([propertyId])
  @@index([readAt])
}

// ---------------- SECURITY AUDIT TRAIL ----------------
model AuditLog {
  id              String            @id @default(uuid())
  adminId         String
  admin           User              @relation("AdminActions", fields: [adminId], references: [id])
  action          String            // APPROVE_PROPERTY, REJECT_PROPERTY, ADMIN_CREATE_PRODUCT, VERIFY_DEALER
  targetEntity    String            // Property, Dealer, Product, Service
  targetId        String
  targetName      String
  details         String
  ipAddress       String?
  timestamp       DateTime          @default(now())
}

// ---------------- LOGIN THROTTLING ----------------
// Failed-login counters, keyed by client IP. This lived in an in-process Map,
// which meant a restart wiped every lockout and a second instance enforced its
// own independent count — so restarting the server was a reliable way to defeat
// the brute-force limit.
model LoginThrottle {
  key       String   @id
  count     Int      @default(0)
  firstAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([firstAt])
}

// ---------------- SESSION REVOCATION ----------------
// Session tokens are self-contained HMACs, so nothing in the token itself can be
// withdrawn — "log out" used to be purely client-side and a leaked token stayed
// valid for its full lifetime (up to 30 days with "remember me"). Each token
// carries a jti; logging out records that jti here and requireAuth rejects it.
//
// expiresAt mirrors the token's own exp, so rows can be pruned on a timer and the
// table never grows without bound.
model RevokedSession {
  jti       String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime @default(now())

  @@index([expiresAt])
  @@index([userId])
}

// ---------------- ONE-TIME AUTH TOKENS ----------------
// Backs both email verification and password reset. The token that travels in
// the email link is random and is never stored — only its hash is, so a leaked
// database dump cannot be replayed against the API. Each row is single-use
// (usedAt) and time-boxed (expiresAt).
enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model AuthToken {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, type])
  @@index([expiresAt])
}

// ---------------- CONTACT MESSAGES ----------------
// Messages sent through the public contact.html form.
//
// contact.html used to fake its own submission: the handler waited 800ms, then
// displayed "your message has been sent" without any network call, so every
// enquiry was silently discarded while the visitor was told it had been
// delivered. These rows are the real destination.
model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  // Recorded so an admin triaging spam can see where a message came from.
  // Null when the visitor submitted without a phone number.
  createdAt DateTime @default(now())
  readAt    DateTime?

  @@index([createdAt])
  @@index([readAt])
}

// ---------------- REPORTS & MODERATION ----------------
model Report {
  id              String            @id @default(uuid())
  reporterId      String?
  reporter        User?             @relation(fields: [reporterId], references: [id])
  targetType      String            // PROPERTY, DEALER, PRODUCT
  targetId        String
  reason          String
  status          String            @default("PENDING")
  createdAt       DateTime          @default(now())
}
